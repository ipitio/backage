{
  "name": "backage-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "build": "astro build && node scripts/package-shell.ts",
    "check": "astro check",
    "dev": "astro dev",
    "test": "node --test src/lib/*.test.ts",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "astro": "7.2.0",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false
  },
  "dependencies": {
    "@picocss/pico": "2.1.1",
    "chart.js": "4.5.1",
    "zod": "4.4.3"
  }
}

---
const dataRoot = "__BKG_DATA_ROOT__";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href={`${dataRoot}favicon.ico`} />
    <title>Backage dashboard candidate</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`${dataRoot}README.md`}>
        <img src={`${dataRoot}logo-b.webp`} alt="" width="48" height="48" />
        <span>Backage</span>
      </a>
      <nav aria-label="Index resources">
        <a href={`${dataRoot}README.md`}>Documentation</a>
        <a href={`${dataRoot}dashboard.json`}>Current data</a>
        <a href={`${dataRoot}dashboard-history.json`}>History</a>
      </nav>
    </header>

    <main>
      <p class="eyebrow">Index dashboard candidate</p>
      <h1>Backage</h1>
      <p class="lede">Package index status</p>

      <section aria-labelledby="publication-heading">
        <div class="section-heading">
          <div>
            <p class="section-label">Publication</p>
            <h2 id="publication-heading">Static shell ready</h2>
          </div>
          <span class="status"><span aria-hidden="true"></span>Build verified</span>
        </div>

        <dl>
          <div>
            <dt>Current projection</dt>
            <dd><a href={`${dataRoot}dashboard.json`}>dashboard.json</a></dd>
          </div>
          <div>
            <dt>Daily history</dt>
            <dd>
              <a href={`${dataRoot}dashboard-history.json`}>
                dashboard-history.json
              </a>
            </dd>
          </div>
          <div>
            <dt>Package index</dt>
            <dd><a href={dataRoot}>Browse root</a></dd>
          </div>
        </dl>
      </section>
    </main>

    <footer>
      <a href={`${dataRoot}README.md`}>Backage documentation</a>
    </footer>
  </body>
</html>

<style>
  :root {
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    color: #19231e;
    background: #f2f5f3;
    font-synthesis: none;
  }

  * {
    box-sizing: border-box;
  }

  body {
    min-height: 100vh;
    margin: 0;
    background: #f2f5f3;
  }

  a {
    color: #116b4a;
    text-underline-offset: 0.18em;
  }

  a:hover {
    color: #8a4219;
  }

  a:focus-visible {
    outline: 3px solid #d88a31;
    outline-offset: 3px;
  }

  .site-header {
    display: flex;
    min-height: 76px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 12px clamp(20px, 5vw, 72px);
    border-bottom: 1px solid #ccd5cf;
    background: #ffffff;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: #19231e;
    font-size: 1.05rem;
    font-weight: 720;
    text-decoration: none;
  }

  .brand img {
    width: 44px;
    height: 44px;
    object-fit: contain;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px 20px;
    font-size: 0.9rem;
    font-weight: 650;
  }

  main {
    width: min(960px, calc(100% - 40px));
    margin: 0 auto;
    padding: clamp(48px, 8vw, 92px) 0 72px;
  }

  .eyebrow,
  .section-label {
    margin: 0;
    color: #547063;
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1 {
    max-width: 760px;
    margin: 8px 0 0;
    font-size: 4.5rem;
    font-weight: 760;
    line-height: 1;
    letter-spacing: 0;
  }

  .lede {
    margin: 16px 0 52px;
    color: #4b5e54;
    font-size: 1.2rem;
  }

  section {
    border-top: 4px solid #1f8b61;
    background: #ffffff;
  }

  .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 28px;
    border-bottom: 1px solid #d8dfdb;
  }

  h2 {
    margin: 5px 0 0;
    font-size: 1.35rem;
    line-height: 1.25;
    letter-spacing: 0;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #315346;
    font-size: 0.82rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .status span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #20a46f;
    box-shadow: 0 0 0 4px #dff4e9;
  }

  dl {
    margin: 0;
  }

  dl div {
    display: grid;
    grid-template-columns: minmax(150px, 0.8fr) minmax(0, 1.2fr);
    gap: 24px;
    padding: 18px 28px;
    border-bottom: 1px solid #e0e5e2;
  }

  dl div:last-child {
    border-bottom: 0;
  }

  dt {
    color: #596a61;
  }

  dd {
    min-width: 0;
    margin: 0;
    font-weight: 650;
    overflow-wrap: anywhere;
  }

  footer {
    width: min(960px, calc(100% - 40px));
    margin: 0 auto;
    padding: 0 0 36px;
    color: #607168;
    font-size: 0.82rem;
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 3rem;
    }

    .site-header,
    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    nav {
      justify-content: flex-start;
    }

    dl div {
      grid-template-columns: 1fr;
      gap: 5px;
    }
  }

  @media (prefers-color-scheme: dark) {
    :root,
    body {
      color: #ecf3ef;
      background: #151a17;
    }

    .site-header,
    section {
      background: #1d2420;
    }

    .site-header,
    .section-heading,
    dl div {
      border-color: #37423c;
    }

    .brand {
      color: #ecf3ef;
    }

    a {
      color: #6ed5aa;
    }

    a:hover {
      color: #f1ae72;
    }

    .eyebrow,
    .section-label,
    .lede,
    dt,
    footer {
      color: #a9b9b0;
    }

    .status {
      color: #a8dbc4;
    }

    .status span {
      box-shadow: 0 0 0 4px #254b39;
    }
  }
</style>

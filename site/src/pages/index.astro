---
import DistributionSection from "../components/DistributionSection.astro";
import HistorySection from "../components/HistorySection.astro";
import InventorySection from "../components/InventorySection.astro";
import MetricsSection from "../components/MetricsSection.astro";
import NoScriptFallback from "../components/NoScriptFallback.astro";
import PublicationStatus from "../components/PublicationStatus.astro";
import SiteShell from "../components/SiteShell.astro";

const dataRoot = "__BKG_DATA_ROOT__";
---

<SiteShell
  dashboardUrl={`${dataRoot}dashboard.json`}
  dataRoot={dataRoot}
  latestReleaseUrl="__BKG_LATEST_RELEASE_URL__"
>
  <header class="page-heading">
    <div>
      <p class="eyebrow">GitHub Packages</p>
      <h1>backage index</h1>
    </div>
    <PublicationStatus />
  </header>

  <div id="dashboard-content" hidden>
    <InventorySection />
    <HistorySection />
    <div class="distribution-grid">
      <DistributionSection
        bodyId="package-types"
        heading="Package types"
        headingId="types-heading"
        itemLabel="Type"
        regionLabel="Package type distribution"
      />
      <DistributionSection
        bodyId="freshness"
        heading="Last package observation"
        headingId="freshness-heading"
        itemLabel="Observed"
        regionLabel="Package freshness distribution"
      />
    </div>
    <MetricsSection />
  </div>

  <NoScriptFallback />
</SiteShell>

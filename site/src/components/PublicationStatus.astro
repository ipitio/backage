---
import { RotateCw } from "@lucide/astro";
---

<section
  class="publication-status requires-js"
  id="publication-status"
  data-tone="loading"
  aria-labelledby="status-title"
>
  <div
    id="status-live"
    role="status"
    aria-live="polite"
    aria-atomic="true"
    aria-busy="true"
  >
    <strong id="status-title">Loading index snapshot</strong>
    <small id="status-detail">Reading the current published data.</small>
  </div>
  <button id="retry" type="button" hidden><RotateCw size={16} aria-hidden="true" /> Retry</button>
</section>

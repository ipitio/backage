---
import "@picocss/pico/css/pico.classless.min.css";
import "../styles/dashboard.css";
import { ArrowUpRight } from "@lucide/astro";

interface Props {
  dashboardUrl: string;
  dataRoot: string;
  latestReleaseUrl: string;
}

const { dashboardUrl, dataRoot, latestReleaseUrl } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="description"
      content="The backage GitHub Packages catalog, observation dates, and index history."
    />
    <link rel="icon" href={`${dataRoot}favicon.ico`} />
    <title>backage package index</title>
  </head>
  <body data-dashboard-url={dashboardUrl}>
    <header class="site-header">
      <nav aria-label="Index resources">
        <a class="brand" href={dataRoot}>
          <img src={`${dataRoot}logo-b.webp`} alt="" width="32" height="32" />
          <strong>backage</strong>
        </a>
        <ul class="resource-links">
          <li><a href={`${dataRoot}README.md`}>Documentation</a></li>
          <li>
            <a href={latestReleaseUrl}>
              Latest release <ArrowUpRight size={16} aria-hidden="true" />
            </a>
          </li>
        </ul>
      </nav>
    </header>

    <main><slot /></main>

    <footer>
      <span class="footer-label">Published data</span>
      <nav aria-label="Dashboard data">
        <ul>
          <li><a href={`${dataRoot}dashboard.json`}>Dashboard JSON</a></li>
          <li><a href={`${dataRoot}dashboard-history.json`}>History JSON</a></li>
          <li><a href={`${dataRoot}.json`}>Index JSON</a></li>
        </ul>
      </nav>
    </footer>
  </body>
</html>

<script>
  import { startDashboard } from "../lib/dashboard-client";

  startDashboard();
</script>
